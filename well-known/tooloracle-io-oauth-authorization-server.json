{
  "issuer": "https://feedoracle.io",
  "authorization_endpoint": "https://feedoracle.io/mcp/authorize",
  "token_endpoint": "https://feedoracle.io/mcp/token",
  "registration_endpoint": "https://feedoracle.io/mcp/register",
  "revocation_endpoint": "https://feedoracle.io/mcp/revoke",
  "scopes_supported": [
    "mcp:read",
    "mcp:tools:read",
    "mcp:oracles:read",
    "mcp:compliance:read",
    "mcp:risk:read",
    "mcp:macro:read",
    "mcp:verified-reports:read"
  ],
  "response_types_supported": ["code"],
  "grant_types_supported": ["authorization_code", "refresh_token", "client_credentials"],
  "token_endpoint_auth_methods_supported": ["client_secret_post", "client_secret_basic"],
  "code_challenge_methods_supported": ["S256"],
  "service_documentation": "https://tooloracle.io/docs",
  "jwks_uri": "https://feedoracle.io/.well-known/jwks.json",
  "federation_note": "tooloracle.io delegates OAuth to feedoracle.io. Tokens issued by feedoracle.io are valid for all tooloracle.io MCP resources."
}
